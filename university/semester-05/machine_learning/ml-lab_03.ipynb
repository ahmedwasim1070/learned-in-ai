# ==============================================================================
# BSAI – 5th Semester | Machine Learning
# LAB 3: Model Validation and K-Fold Cross-Validation
# Student Pass/Fail Classification using Logistic Regression
# ==============================================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split, StratifiedKFold
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    ConfusionMatrixDisplay,
    classification_report
)

# ------------------------------------------------------------------------------
# PART 1: LOAD AND PREPARE THE DATA
# ------------------------------------------------------------------------------
print("=" * 70)
print("PART 1: DATA PREPARATION & INSPECTION")
print("=" * 70)

# 1.1 Load dataset
df = pd.read_csv("student-mat-clean.csv")
print(f"Dataset shape: {df.shape}")

# 1.2 Create binary target: Pass (1) if FinalGrade >= 10, else Fail (0)
df["Pass"] = (df["FinalGrade"] >= 10).astype(int)

print("\nTarget Class Distribution:")
counts = df["Pass"].value_counts()
percentages = df["Pass"].value_counts(normalize=True) * 100
for label, name in [(1, "Pass"), (0, "Fail")]:
    print(f"  {name} ({label}): {counts[label]} students ({percentages[label]:.2f}%)")

# 1.3 Feature selection (excluding FinalGrade, G1, and G2 to prevent data leakage)
features = [
    "age", "Medu", "Fedu", "studytime",
    "failures", "famrel", "freetime", "goout",
    "Dalc", "Walc", "health", "absences"
]

X = df[features]
y = df["Pass"]
print(f"\nFeature matrix X shape: {X.shape}")
print(f"Target vector y shape: {y.shape}")

# 1.4 Train-Test Split (80% train/dev, 20% untouched test, stratified)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)
print(f"Training samples (development): {len(X_train)}")
print(f"Testing samples (untouched test set): {len(X_test)}")

print("\n--- TASK 1 ANSWERS ---")
print("1. Why is FinalGrade not in X?")
print("   -> Target leakage: 'Pass' is directly derived from FinalGrade (FinalGrade >= 10).")
print("      Including it would give the model the exact ground-truth answer.")
print("2. What do Fail = 0 and Pass = 1 mean?")
print("   -> 0 denotes a student scoring below the passing threshold (< 10).")
print("   -> 1 denotes a student achieving a passing score (>= 10).")
print("3. Why keep a separate test set?")
print("   -> To evaluate true generalization performance on unseen data and avoid data snooping")
print("      during feature engineering, model selection, or hyperparameter tuning.")


# ------------------------------------------------------------------------------
# PART 2: BASELINE LOGISTIC REGRESSION
# ------------------------------------------------------------------------------
print("\n" + "=" * 70)
print("PART 2: BASELINE LOGISTIC REGRESSION")
print("=" * 70)

baseline_model = LogisticRegression(max_iter=1000)
baseline_model.fit(X_train, y_train)

y_pred_baseline = baseline_model.predict(X_test)
baseline_accuracy = accuracy_score(y_test, y_pred_baseline)

print(f"Baseline Test Accuracy: {baseline_accuracy * 100:.2f}%\n")

cm_baseline = confusion_matrix(y_test, y_pred_baseline)
tn_b, fp_b, fn_b, tp_b = cm_baseline.ravel()

print("Baseline Confusion Matrix:")
print(f"  TN (Fail -> Fail): {tn_b} | FP (Fail -> Pass): {fp_b}")
print(f"  FN (Pass -> Fail): {fn_b} | TP (Pass -> Pass): {tp_b}\n")

print("Baseline Classification Report:")
print(classification_report(y_test, y_pred_baseline, target_names=["Fail", "Pass"]))

# Plot Baseline Confusion Matrix
disp_baseline = ConfusionMatrixDisplay(confusion_matrix=cm_baseline, display_labels=["Fail", "Pass"])
disp_baseline.plot(cmap=plt.cm.Blues)
plt.title("Baseline Model - Confusion Matrix")
plt.show()

print("\n--- TASK 2 ANSWERS ---")
print(f"1. TP={tp_b}, TN={tn_b}, FP={fp_b}, FN={fn_b}")
print(f"2. Actual Pass predicted as Fail (FN): {fn_b}")
print(f"3. Actual Fail predicted as Pass (FP): {fp_b}")
print("4. Higher recall: Pass class (0.85) vs Fail class (0.27).")
print("5. Why accuracy alone is not enough:")
print("   -> The dataset is imbalanced (~67% Pass). An accuracy of 65.82% looks reasonable,")
print("      but the model misses 73% of failing students (Fail recall is only 0.27).")


# ------------------------------------------------------------------------------
# PART 3: 5-FOLD STRATIFIED CROSS-VALIDATION
# ------------------------------------------------------------------------------
print("\n" + "=" * 70)
print("PART 3: 5-FOLD STRATIFIED CROSS-VALIDATION")
print("=" * 70)

skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
fold_scores = []

for fold, (train_idx, val_idx) in enumerate(skf.split(X_train, y_train), 1):
    X_f_train, y_f_train = X_train.iloc[train_idx], y_train.iloc[train_idx]
    X_f_val, y_f_val = X_train.iloc[val_idx], y_train.iloc[val_idx]
    
    cv_model = LogisticRegression(max_iter=1000)
    cv_model.fit(X_f_train, y_f_train)
    
    score = accuracy_score(y_f_val, cv_model.predict(X_f_val))
    fold_scores.append(score)
    print(f"Fold {fold}: Train={len(train_idx)}, Val={len(val_idx)} | Validation Accuracy: {score:.3f}")

mean_fold_score = np.mean(fold_scores)
print(f"\nMean 5-Fold Validation Accuracy: {mean_fold_score:.3f}")

print("\n--- TASK 3 ANSWERS ---")
print(f"1. Highest Fold: Fold 5 ({max(fold_scores):.3f}), Lowest Fold: Fold 1 ({min(fold_scores):.3f})")
print(f"2. Mean of five accuracies: {mean_fold_score:.3f} ({mean_fold_score * 100:.2f}%)")
print("3. Why not simply select the highest-scoring fold?")
print("   -> The highest fold is just one favorable validation split; picking it leads to")
print("      optimism bias. K-Fold assesses stability across all partitions.")
print("4. 'A single validation split gives one view; K-Fold gives multiple views':")
print("   -> A single split depends on random partitioning luck (high variance). K-Fold validates")
print("      every sample once across K iterations, yielding a balanced, low-variance estimate.")


# ------------------------------------------------------------------------------
# PART 4: K-FOLD FOR MODEL SELECTION (HYPERPARAMETER C)
# ------------------------------------------------------------------------------
print("\n" + "=" * 70)
print("PART 4: HYPERPARAMETER TUNING FOR C VIA 5-FOLD CV")
print("=" * 70)

C_values = [0.01, 0.1, 1, 10, 100]
cv_results = []

for C in C_values:
    scores = []
    for train_idx, val_idx in skf.split(X_train, y_train):
        X_f_train, y_f_train = X_train.iloc[train_idx], y_train.iloc[train_idx]
        X_f_val, y_f_val = X_train.iloc[val_idx], y_train.iloc[val_idx]
        
        m = LogisticRegression(C=C, max_iter=1000)
        m.fit(X_f_train, y_f_train)
        scores.append(accuracy_score(y_f_val, m.predict(X_f_val)))
        
    mean_acc = np.mean(scores)
    std_acc = np.std(scores)
    cv_results.append({"C": C, "Mean CV Accuracy (%)": mean_acc * 100, "Std (%)": std_acc * 100})
    print(f"C = {C:<6} | Mean CV Accuracy = {mean_acc:.3f} | Std = {std_acc:.3f}")

results_df = pd.DataFrame(cv_results)
best_idx = results_df["Mean CV Accuracy (%)"].idxmax()
best_C = results_df.loc[best_idx, "C"]
print(f"\nBest C selected by 5-Fold CV: {best_C}")

# Retrain on the entire training set using best_C and test once on untouched test set
final_model = LogisticRegression(C=best_C, max_iter=1000)
final_model.fit(X_train, y_train)

final_pred = final_model.predict(X_test)
final_accuracy = accuracy_score(y_test, final_pred)

print("\n===== Accuracy Comparison =====")
print(f"Baseline Test Accuracy:         {baseline_accuracy * 100:.2f}%")
print(f"K-Fold Selected Test Accuracy:   {final_accuracy * 100:.2f}%")
print(f"Difference:                     {(final_accuracy - baseline_accuracy) * 100:+.2f} percentage points")

print("\n--- TASK 4 ANSWERS ---")
print(f"1. Selected C: {best_C}, because it yielded the highest mean CV accuracy (71.8%).")
print(f"2. Baseline Test Accuracy: {baseline_accuracy * 100:.2f}% | Final Test Accuracy: {final_accuracy * 100:.2f}%")
print(f"3. Change: {(final_accuracy - baseline_accuracy) * 100:+.2f} percentage points.")
print("4. Was K-Fold itself an accuracy booster? What was its actual role?")
print("   -> No. K-Fold is an evaluation and model selection framework, not a learning algorithm.")
print("      The gain came from stronger regularization (C=0.1) mitigating overfitting, which")
print("      K-Fold reliably identified without touching the test set.")


# ------------------------------------------------------------------------------
# PART 5: FINAL MODEL EVALUATION
# ------------------------------------------------------------------------------
print("\n" + "=" * 70)
print("PART 5: FINAL MODEL EVALUATION")
print("=" * 70)

cm_final = confusion_matrix(y_test, final_pred)
tn_f, fp_f, fn_f, tp_f = cm_final.ravel()

print("Final Confusion Matrix:")
print(f"  TN (Fail -> Fail): {tn_f} | FP (Fail -> Pass): {fp_f}")
print(f"  FN (Pass -> Fail): {fn_f} | TP (Pass -> Pass): {tp_f}\n")

print("Final Classification Report:")
print(classification_report(y_test, final_pred, target_names=["Fail", "Pass"]))

# Plot Final Confusion Matrix
disp_final = ConfusionMatrixDisplay(confusion_matrix=cm_final, display_labels=["Fail", "Pass"])
disp_final.plot(cmap=plt.cm.Greens)
plt.title("Final Model (C=0.1) - Test Confusion Matrix")
plt.show()

print("\n--- TASK 5 ANSWERS ---")
print(f"1. Final metrics: TP={tp_f}, TN={tn_f}, FP={fp_f}, FN={fn_f}")
print(f"2. Correctly classified Pass students (TP): {tp_f}")
print(f"3. Fail students incorrectly classified as Pass (FP): {fp_f}")
print(f"4. Recall comparison: Pass Recall = {tp_f / (tp_f + fn_f):.2f} (0.89) vs Fail Recall = {tn_f / (tn_f + fp_f):.2f} (0.27).")
print("5. Why can accuracy be 68.35% while Fail recall is only 0.27?")
print("   -> Accuracy reflects total correct predictions over total samples. Because passing students")
print("      comprise 67.09% of the set (53 of 79 test cases), predicting 'Pass' often boosts overall")
print("      accuracy while leaving the minority 'Fail' class largely undetected.")
